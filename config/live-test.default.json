{
  "schema": "joomengine.joomla-mcp.live-scenario/v1",
  "name": "Complete Joomla MCP live scenario",
  "description": "Deterministic multi-record scenario that proves real MCP create, list, get, update, publish, assignment, delete, and postcondition behavior.",
  "target": {
    "configurationFile": "config/sites.json",
    "actorUsernames": {
      "api": "mcpfixture",
      "cli": "mcpfixture"
    }
  },
  "selection": {
    "profile": "full",
    "joomlaPaths": ["api", "cli"],
    "mcpTransports": ["stdio", "http"],
    "families": []
  },
  "safety": {
    "confirmMutations": true,
    "disposable": true,
    "cleanup": "always"
  },
  "progress": {
    "enabled": true,
    "heartbeatSeconds": 30
  },
