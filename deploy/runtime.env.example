# Values here override the startup-readiness probe defaults in joomla-mcp.service.
# JOOMLA_MCP_HEALTH_HOST must exactly match an allowedHosts entry in sites.json.
JOOMLA_MCP_HEALTH_ADDRESS=127.0.0.1
JOOMLA_MCP_HEALTH_HOST=127.0.0.1:3000
# Set JOOMLA_MCP_HEALTH_ORIGIN to an exact allowedOrigins value when
# http.requireOrigin is true. Leave it empty otherwise.
JOOMLA_MCP_HEALTH_ORIGIN=
JOOMLA_MCP_HEALTH_PATH=/readyz
JOOMLA_MCP_HEALTH_PORT=3000
JOOMLA_MCP_HEALTH_TIMEOUT_MS=3000
JOOMLA_MCP_STARTUP_TIMEOUT_MS=30000
