{
  "name": "@joomengine/joomla-mcp",
  "version": "0.7.0",
  "description": "Embeddable and self-hosted Model Context Protocol server for administering Joomla 6.x.",
  "homepage": "https://github.com/joomengine/joomla-mcp#readme",
  "bugs": {
    "url": "https://github.com/joomengine/joomla-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joomengine/joomla-mcp.git"
  },
  "keywords": [
    "joomla",
    "mcp",
    "model-context-protocol",
    "automation",
    "cms"
  ],
  "files": [
    "dist",
    "config/sites.example.json",
    "config/sites.single-site-readonly.example.json",
    "config/live-test.default.json",
    "docs",
    "examples/embedded-host",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/infrastructure/index.d.ts",
      "import": "./dist/infrastructure/index.js",
      "default": "./dist/infrastructure/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js",
      "default": "./dist/catalog/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "default": "./dist/http/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js",
      "default": "./dist/security/index.js"
    },
    "./live-test": {
      "types": "./dist/live-test/index.d.ts",
      "import": "./dist/live-test/index.js",
      "default": "./dist/live-test/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "joomla-mcp": "dist/bin/joomla-mcp.js",
    "joomla-mcp-http": "dist/bin/joomla-mcp-http.js",
    "joomla-mcp-live-test": "dist/bin/joomla-mcp-live-test.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin/joomla-mcp.ts",
    "dev:http": "tsx src/bin/joomla-mcp-http.ts",
    "start": "node dist/bin/joomla-mcp.js",
    "start:http": "node dist/bin/joomla-mcp-http.js",
    "test": "vitest run",
    "test:contract": "vitest run tests/contracts",
    "test:fixture:joomengine": "./scripts/fixtures/run-joomengine.sh",
    "test:live": "npm run build --silent && node dist/bin/joomla-mcp-live-test.js",
    "test:package": "node scripts/release/test-package-consumer.mjs",
    "test:security": "vitest run tests/*security*.test.ts tests/confirmation-service.test.ts tests/permission-grant-service.test.ts",
    "docs:actions": "node --import tsx scripts/generate-api-action-reference.mts",
    "docs:actions:check": "node --import tsx scripts/generate-api-action-reference.mts --check",
    "package:check": "node scripts/release/verify-package.mjs",
    "prepack": "npm run build",
    "version:check": "node scripts/release/sync-version.mjs --check",
    "version:plan": "node scripts/release/plan-version.mjs",
    "version:sync": "node scripts/release/sync-version.mjs",
    "validate": "npm run version:check && npm run check && npm test && npm run docs:actions:check && npm run build && npm run package:check && npm run test:package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^26.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.8"
  },
  "license": "GPL-2.0-or-later"
}
